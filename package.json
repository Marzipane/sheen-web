{
  "name": "@marzipane/sheen-web",
  "version": "0.7.0",
  "description": "sheen for the web: the glass design system of Flutter sheen as CSS custom properties, a small script, Blade components and framework-free app elements.",
  "license": "MIT",
  "repository": "github:Marzipane/sheen-web",
  "style": "dist/sheen.css",
  "main": "dist/sheen.js",
  "files": [
    "dist",
    "tokens",
    "icons"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check && node scripts/check-flutter.mjs",
    "test:elements": "node --test tests/elements/*.test.mjs",
    "test": "node build.mjs --check && node --test tests/elements/*.test.mjs && vendor/bin/phpunit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
